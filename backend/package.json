{
  "name": "connected-panchayat-backend",
  "version": "1.0.0",
  "description": "Backend API for Connected Panchayat",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:setup": "node scripts/setupDb.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/setupDb.js && node scripts/seed.js",
